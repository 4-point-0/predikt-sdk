# Inputs for scripts/e2e-checklist.mjs (its header lists every option).
# Copy to e2e.env (git-ignored), fill in the values, then run:
#   npm run build && node --env-file=e2e.env scripts/e2e-checklist.mjs
# The SDK itself never reads this file; only the test script does.

# --- Required -------------------------------------------------------------------------------

# Predikt API base URL (develop: https://prediktback.4pto.dev).
PREDIKT_API_URL=
# Backend API key of the test integrator (sk_predikt_..., keyType "backend").
PREDIKT_API_KEY=
# Privy app of the test integrator (Privy dashboard).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Owner key private key (Privy dashboard -> authorization keys), "wallet-auth:..." or PEM.
# Used only to sign approvals locally; never sent anywhere.
PRIVY_OWNER_KEY=
# Privy wallet created with owner_id = the owner key quorum ID.
PRIVY_WALLET_ID=

# --- Defaults (change if needed) ------------------------------------------------------------

# production | development
PRIVY_ENVIRONMENT=production
# Grant cap per buy, pUSD base units (2000000 = 2 pUSD).
E2E_MAX_BUY=2000000
# Grant expiry. Keep it fixed between runs, or register fails with TRADING_AUTHORIZATION_EXISTS.
E2E_EXPIRES_AT=2027-12-31T00:00:00Z

# --- Trading (real funds, optional) ---------------------------------------------------------

# 1 = run the steps that trade. Leave empty for the first run.
E2E_TRADE=
# Combo budget, base units (default 1000000 = 1 pUSD).
E2E_COMBO_AMOUNT=
# "marketId:outcome,marketId:outcome"; empty = picked automatically.
E2E_COMBO_LEGS=
# 1 = keep the combo instead of cashing it out (to test the payout once it resolves).
E2E_KEEP_COMBO=
# Outcome token ID for the direct buy + sell test; empty = skipped.
E2E_TOKEN_ID=
# Direct buy budget, base units (default 2000000, at most E2E_MAX_BUY). Polymarket rejects buys
# under $1 (the backend reserves ~3% for fees first, so 1000000 is too small) and under ~5 shares.
E2E_DIRECT_AMOUNT=
# Resolved market (conditionId) to redeem directly; empty = skipped.
E2E_REDEEM_CONDITION_ID=
